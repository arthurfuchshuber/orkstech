# Copie para .env e preencha com os valores do projeto Supabase (Settings → API).
# Nunca commite o arquivo .env.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Edge Functions (Supabase Dashboard → Edge Functions → Secrets)
# CRON_SECRET=                    # pluggy-auto-sync + sync-qsa bulk + mesmo valor em app.cron_secret
# PLUGGY_WEBHOOK_SECRET=          # validação do pluggy-webhook (header x-pluggy-webhook-secret ou ?secret=)
